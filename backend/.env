# Currency for pricing display
CURRENCY=INR

# JWT Secret - used to sign authentication tokens (use a long random string in production)
JWT_SECRET=your_jwt_secret_here

# Admin Panel Credentials (change these before deploying)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_admin_password_here

# MongoDB Setup (required)
# Get this from MongoDB Atlas: https://cloud.mongodb.com -> Connect -> Drivers
MONGODB_URI=mongodb+srv://your_username:your_password@your_cluster.mongodb.net/doctor_db?retryWrites=true&w=majority

# Cloudinary Setup (required) - for image/file uploads
# Get these from https://cloudinary.com/console
CLOUDINARY_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_SECRET_KEY=your_cloudinary_api_secret

# Razorpay Payment Integration (test mode)
# Get these from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=your_razorpay_test_key_id
RAZORPAY_KEY_SECRET=your_razorpay_test_key_secret

# Stripe Payment Integration (optional, alternative to Razorpay)
# STRIPE_SECRET_KEY=your_stripe_secret_key_here
